---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import NavIcon from '../../components/NavIcon.astro';
import ToolCard from '../../components/ToolCard.astro';
import { CATEGORIES, type Category } from '../../tools/categories';
import { toolsInCategory } from '../../tools/registry';

export function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { id: c.id }, props: { cat: c } }));
}

interface Props {
  cat: Category;
}
const { cat } = Astro.props;
const tools = toolsInCategory(cat.id);
---

<BaseLayout title={`${cat.name} Hesaplamaları`} description={`${cat.description} Ücretsiz, açıklamalı ve güncel.`} activeCategory={cat.id}>
  <div class="container">
    <Breadcrumbs items={[{ name: 'Ana sayfa', href: '/' }, { name: cat.name }]} />
    <div class="panel">
      <div class="panel__head">
        <div>
          <h1 class="panel__title panel__title--icon">
            <span class="section-title__icon" style={`--tint:${cat.color}`}><NavIcon name={cat.id} /></span>
            {cat.name}
          </h1>
          <p class="panel__sub">{cat.description}</p>
        </div>
      </div>
      {
        tools.length > 0 ? (
          <ul class="rgrid">
            {tools.map((t) => (
              <li>
                <ToolCard tool={t} />
              </li>
            ))}
          </ul>
        ) : (
          <div class="result-empty">Bu başlıktaki robotlar hazırlanıyor. Çok yakında burada olacaklar.</div>
        )
      }
    </div>
  </div>
</BaseLayout>
