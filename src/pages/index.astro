---
import BaseLayout from '../layouts/BaseLayout.astro';
import KpiStrip from '../components/KpiStrip.astro';
import PratikKutular from '../components/PratikKutular.astro';
import { TOOLS } from '../tools/registry';
import { formatDateTR } from '../lib/format';
import { todayIsoTR } from '../lib/finance';
import { SITE } from '../site.config';

// Robot başlıkları sol menüde; ana sayfada yalnızca "Bu ayın rakamları" ve pratik araçlar (site sahibinin isteği).
const today = todayIsoTR();

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: (Astro.site ?? new URL(SITE.url)).href,
    inLanguage: 'tr-TR',
    description: SITE.description,
  },
];
---

<BaseLayout title={`${SITE.name} – Türkiye’nin açıklamalı hesaplama robotları`} description={SITE.description} jsonLd={jsonLd}>
  <div class="container">
    <div class="panel panel--home">
      <div class="panel__head">
        <div>
          <h1 class="panel__title">Hesaplama robotları</h1>
          <p class="panel__sub">{TOOLS.length} ücretsiz robot · Türkiye’nin güncel kurallarıyla · kaynaklı</p>
        </div>
        <div class="panel__tools">
          <span class="panel__date" data-today>{formatDateTR(today)}</span>
          <a class="btn btn--accent" href="/kredi-hesaplama/">+ Kredi hesapla</a>
        </div>
      </div>

      <KpiStrip />

      <PratikKutular />
    </div>
  </div>
</BaseLayout>

<script>
  // Tarih, sayfanın derlendiği gün yerine ziyaretçinin bugünü olsun.
  const el = document.querySelector<HTMLElement>('[data-today]');
  if (el) el.textContent = new Intl.DateTimeFormat('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date());
</script>
