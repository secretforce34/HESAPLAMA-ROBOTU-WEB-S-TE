---
import ToolLayout from '../layouts/ToolLayout.astro';
import Calculator from '../tools/miras-hesaplama/Calculator';
import { meta } from '../tools/miras-hesaplama/meta';
import { verasetVergisi } from '../data/params/veraset';
import { verasetHesapla, yasalPaylar } from '../tools/miras-hesaplama/calc';
import { formatTL } from '../lib/format';
import type { FaqItem } from '../tools/types';

const v = verasetVergisi.values;
const ornek = verasetHesapla(10_000_000, yasalPaylar({ es: true, cocuklar: [{ sag: true, torunSayisi: 0 }, { sag: true, torunSayisi: 0 }], anne: false, baba: false, kardes: 0, zumre3: false }));

const faq: FaqItem[] = [
  {
    q: 'Eş ve çocuklar arasında miras nasıl paylaşılır?',
    a: 'Eş, çocuklarla birlikte mirasçı olduğunda mirasın 1/4’ünü alır; kalan 3/4 çocuklar arasında eşit bölünür. Eşi olmayanın mirası çocuklarına eşit kalır. Miras bırakandan önce ölen çocuğun payı onun çocuklarına (torunlara) geçer.',
  },
  {
    q: 'Çocuk yoksa miras kime kalır?',
    a: 'Çocuk ve torun yoksa eş mirasın 1/2’sini, anne ve baba kalan yarıyı eşit olarak alır. Vefat etmiş ebeveynin payı kardeşlere geçer. Anne-baba ve kardeş de yoksa eş 3/4’ünü alır, kalan büyükanne-büyükbabalara ve onların altsoyuna kalır; onlar da yoksa mirasın tamamı eşindir.',
  },
  {
    q: 'Saklı pay nedir?',
    a: 'Miras bırakanın vasiyetle bile dokunamayacağı paydır. Çocuklar için yasal payın 1/2’si, anne ve baba için her birinin yasal payının 1/4’ü, eş için çocuklar veya anne-baba zümresiyle birlikte mirasçıysa yasal payının tamamı, diğer hâllerde 3/4’üdür. Kardeşlerin saklı payı yoktur.',
  },
  {
    q: '2026’da veraset vergisi istisnası ne kadar?',
    a: `Çocuklar ve eşten her biri için ${formatTL(v.istisnaAltsoyVeEs, 0)}, çocuk yoksa eş için ${formatTL(v.istisnaEsTek, 0)}. Bağış gibi karşılıksız intikallerde istisna ${formatTL(v.istisnaIvazsiz, 0)}. İstisna, her mirasçının kendi payından düşülür.`,
  },
  {
    q: 'Veraset vergisi oranları kaç?',
    a: 'Mirasta ilk 3 milyon TL için %1, sonraki 7 milyon için %3, sonraki 15 milyon için %5, sonraki 30 milyon için %7, 55 milyon TL’yi aşan kısım için %10’dur. Bağışta oranlar %10’dan %30’a kadar çıkar.',
  },
  {
    q: 'Veraset vergisi beyannamesi ne zaman verilir, nasıl ödenir?',
    a: 'Ölüm Türkiye’de gerçekleştiyse mirasçılar ölüm tarihinden itibaren 4 ay içinde vergi dairesine beyanname verir. Vergi 3 yılda, her yıl Mayıs ve Kasım aylarında olmak üzere 6 eşit taksitte ödenir. Vergi çıkmasa da beyanname verilmesi gerekir; banka hesapları ve tapu işlemleri için ilişiksiz belgesi istenir.',
  },
];
---

<ToolLayout meta={meta} faq={faq}>
  <Fragment slot="calculator"><Calculator client:load /></Fragment>

  <h2>Nasıl hesaplanır?</h2>
  <p>
    Önce miras kalan mal varlığından borçlar ve cenaze masrafları düşülür. Kalan net miras, Türk Medeni Kanunu’nun zümre sistemine göre yasal
    mirasçılar arasında paylaştırılır. Veraset vergisi her mirasçının kendi payı üzerinden ayrı hesaplanır.
  </p>
  <div class="formula">Mirasçının vergi matrahı = Payına düşen tutar − İstisna
Vergi = Matrah üzerinden dilimli tarife (%1, %3, %5, %7, %10)</div>

  <h2>Örnek hesaplama</h2>
  <div class="example">
    <p>
      10.000.000 TL net miras bırakan birinin eşi ve iki çocuğu varsa eş 1/4 ile {formatTL(ornek[0].tutar, 0)}, her çocuk 3/8 ile
      {` ${formatTL(ornek[1].tutar, 0)}`} alır. Eşin payı istisnanın altında kaldığı için vergi {formatTL(ornek[0].vergi)}; her çocuk
      {` ${formatTL(ornek[1].tutar, 0)} − ${formatTL(v.istisnaAltsoyVeEs, 0)} = ${formatTL(ornek[1].matrah, 0)}`} matrah üzerinden %1 ile
      {` ${formatTL(ornek[1].vergi)}`} veraset vergisi öder.
    </p>
  </div>
</ToolLayout>
