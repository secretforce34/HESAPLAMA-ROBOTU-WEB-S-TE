---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolSearch from '../ui/ToolSearch';
import { searchItems } from '../lib/search-items';
---

<BaseLayout title="Sayfa bulunamadı" description="Aradığınız sayfa bulunamadı." noindex>
  <div class="container">
    <section class="hero">
      <h1>Bu sayfa bulunamadı.</h1>
      <p class="hero__lead">Robotlarımız her yeri aradı, ama bu adreste bir şey yok. Aşağıdan aradığınız hesaplamayı bulabilirsiniz.</p>
      <ToolSearch items={searchItems()} client:load autofocus />
      <p style="margin-top:20px"><a href="/">← Ana sayfaya dön</a></p>
    </section>
  </div>
</BaseLayout>
