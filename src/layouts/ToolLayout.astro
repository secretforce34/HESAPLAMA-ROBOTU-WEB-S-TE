---
// Her hesaplama sayfasının ortak iskeleti.
// Kullanım:
//   <ToolLayout meta={meta} faq={faq}>
//     <Fragment slot="calculator"><Calculator client:load /></Fragment>
//     <h2>Nasıl hesaplanır?</h2> ... (açıklama içeriği)
//   </ToolLayout>
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faq from '../components/Faq.astro';
import StaleWarning from '../components/StaleWarning.astro';
import ToolAside from '../components/ToolAside.astro';
import RobotAvatar from '../components/RobotAvatar.astro';
import { getCategory } from '../tools/categories';
import { formatDateTR } from '../lib/format';
import { SITE } from '../site.config';
import type { FaqItem, ToolMeta } from '../tools/types';

interface Props {
  meta: ToolMeta;
  faq?: FaqItem[];
}

const { meta, faq = [] } = Astro.props;
const cat = getCategory(meta.category);
const site = Astro.site ?? new URL(SITE.url);
const pageUrl = new URL(`/${meta.slug}/`, site).href;
const stripTags = (html: string) => html.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();

const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: meta.title,
    description: meta.description,
    url: pageUrl,
    applicationCategory: meta.schemaCategory ?? 'FinanceApplication',
    operatingSystem: 'Tümü',
    inLanguage: 'tr-TR',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'TRY' },
    dateModified: meta.lastReviewed,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Ana sayfa', item: new URL('/', site).href },
      { '@type': 'ListItem', position: 2, name: cat.name, item: new URL(`/kategori/${cat.id}/`, site).href },
      { '@type': 'ListItem', position: 3, name: meta.title, item: pageUrl },
    ],
  },
];
if (faq.length > 0) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: stripTags(f.a) },
    })),
  });
}
---

<BaseLayout title={meta.seoTitle} description={meta.description} activeCategory={meta.category} activeSlug={meta.slug} jsonLd={jsonLd}>
  <div class="container">
    <Breadcrumbs items={[{ name: 'Ana sayfa', href: '/' }, { name: cat.name, href: `/kategori/${cat.id}/` }, { name: meta.title }]} />
    <header class="tool-head">
      <RobotAvatar tool={meta} size="lg" />
      <div class="tool-head__text">
        <h1>{meta.title}</h1>
        <p class="tool-head__question">{meta.question}</p>
        <div class="badges">
          <span class="badge badge--ok">🔒 {meta.category === 'pratik' ? 'Dosyalarınız cihazınızdan çıkmaz' : 'Bilgileriniz cihazınızda kalır'}</span>
          {meta.category !== 'pratik' && <span class="badge">✓ Kurallar kontrol edildi: {formatDateTR(meta.lastReviewed)}</span>}
          <span class="badge">Ücretsiz · üyelik yok</span>
        </div>
      </div>
    </header>

    <nav class="tabs" aria-label="Sayfa bölümleri">
      <a href="#hesapla" class="is-active">Hesapla</a>
      <a href="#aciklama">Nasıl hesaplanır?</a>
      {faq.length > 0 && <a href="#sss">Sık sorulanlar</a>}
      <a href="#kaynaklar">Kaynaklar</a>
    </nav>

    <StaleWarning sets={meta.paramSets} />

    <section class="calc" id="hesapla" aria-label={`${meta.title} hesaplayıcısı`}>
      <slot name="calculator" />
    </section>
    <p class="embed-credit">
      <a href={pageUrl} target="_blank" rel="noopener">
        {SITE.name} · {meta.title} — açıklamalı tam sürüm ↗
      </a>
    </p>

    <div class="tool-body">
      <article class="prose panel" id="aciklama">
        <slot />
        {
          faq.length > 0 && (
            <>
              <h2 id="sss">Sık sorulan sorular</h2>
              <Faq items={faq} />
            </>
          )
        }
      </article>
      <script is:inline>
        // Açıklama bölümleri ince açılır başlıklara dönüşür (sayfa aşağı uzamasın diye). İçerik sayfada kalır;
        // betik çalışmazsa bölümler normal biçimde görünür. Sekmeler ve # bağlantıları ilgili bölümü açar.
        (function () {
          var art = document.getElementById('aciklama');
          if (!art) return;
          var govde = null;
          Array.prototype.slice.call(art.children).forEach(function (el) {
            if (el.tagName === 'H2') {
              var d = document.createElement('details');
              d.className = 'bolum';
              var s = document.createElement('summary');
              s.className = 'bolum__baslik';
              art.insertBefore(d, el);
              s.appendChild(el);
              d.appendChild(s);
              govde = document.createElement('div');
              govde.className = 'bolum__icerik';
              d.appendChild(govde);
            } else if (govde) {
              govde.appendChild(el);
            }
          });
          function ac(hash) {
            if (!hash || hash.length < 2) return;
            if (hash === '#aciklama') {
              var ilk = art.querySelector('details.bolum');
              if (ilk) ilk.open = true;
              return;
            }
            var t = document.getElementById(decodeURIComponent(hash.slice(1)));
            var d = t && t.closest('details.bolum');
            if (d) d.open = true;
          }
          ac(location.hash);
          window.addEventListener('hashchange', function () {
            ac(location.hash);
          });
          document.addEventListener('click', function (e) {
            var a = e.target.closest && e.target.closest('a[href^="#"]');
            if (a) ac(a.getAttribute('href'));
          });
        })();
      </script>
      <ToolAside meta={meta} />
    </div>
  </div>
</BaseLayout>
