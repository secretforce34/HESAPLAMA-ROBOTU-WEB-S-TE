---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 36 36" aria-hidden="true" focusable="false">
  <line x1="18" y1="3.5" x2="18" y2="9" stroke="var(--logo-body)" stroke-width="2.2" stroke-linecap="round"></line>
  <circle cx="18" cy="3.6" r="2.6" fill="var(--logo-antenna)"></circle>
  <rect x="3" y="8.5" width="30" height="24" rx="8" fill="var(--logo-body)"></rect>
  <rect x="7" y="13" width="22" height="11.5" rx="5.75" fill="var(--logo-face)"></rect>
  <circle cx="13.2" cy="18.75" r="2.4" fill="var(--logo-eye)"></circle>
  <circle cx="22.8" cy="18.75" r="2.4" fill="var(--logo-eye)"></circle>
  <circle cx="13.9" cy="18" r="0.75" fill="#ffffff"></circle>
  <circle cx="23.5" cy="18" r="0.75" fill="#ffffff"></circle>
  <rect x="13" y="27.2" width="10" height="2.2" rx="1.1" fill="var(--logo-antenna)"></rect>
</svg>
