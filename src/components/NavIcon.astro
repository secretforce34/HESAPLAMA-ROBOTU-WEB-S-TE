---
// Sol menüdeki ince çizgi simgeler (kategori id'sine göre).
interface Props {
  name: string;
  class?: string;
}
const { name, class: className = 'nav-icon' } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {
    name === 'home' && (
      <>
        <rect x="3.5" y="3.5" width="7" height="7" rx="1.5" />
        <rect x="13.5" y="3.5" width="7" height="7" rx="1.5" />
        <rect x="3.5" y="13.5" width="7" height="7" rx="1.5" />
        <rect x="13.5" y="13.5" width="7" height="7" rx="1.5" />
      </>
    )
  }
  {
    name === 'kredi-borc' && (
      <>
        <rect x="2.5" y="5" width="19" height="14" rx="2.5" />
        <path d="M2.5 9.5h19M6.5 15h4" />
      </>
    )
  }
  {
    name === 'arac-ulasim' && (
      <>
        <path d="M5 16.5h14M4 16.5v-4l2-5h12l2 5v4" />
        <path d="M4 12.5h16" />
        <circle cx="7.5" cy="17" r="1.8" />
        <circle cx="16.5" cy="17" r="1.8" />
      </>
    )
  }
  {
    name === 'ev-kira' && (
      <>
        <path d="M3.5 11 12 4l8.5 7" />
        <path d="M5.5 9.5V20h13V9.5" />
        <path d="M10 20v-5.5h4V20" />
