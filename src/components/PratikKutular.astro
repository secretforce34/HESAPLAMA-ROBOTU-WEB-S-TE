---
// Ana sayfadaki üç pratik araç kutusu (QR, PDF düzenleme, PDF dönüştürme).
const kutular = [
  {
    href: '/qr-kod-olusturucu/',
    ad: 'QR Kod Oluşturucu',
    etiketler: ['Bağlantı', 'Wi-Fi', 'Kartvizit', 'IBAN'],
    renk: '#3b82f6',
    simge: 'qr',
  },
  {
    href: '/pdf-duzenleyici/',
    ad: 'PDF Düzenleyici',
    etiketler: ['Birleştir', 'Böl', 'Sayfa sil', 'Yazı ekle', 'İmza'],
    renk: '#ef4444',
    simge: 'duzenle',
  },
  {
    href: '/pdf-donusturucu/',
    ad: 'PDF Dönüştürücü',
    etiketler: ['Word ⇄ PDF', 'Excel ⇄ PDF', 'Resim ⇄ PDF'],
    renk: '#8b5cf6',
    simge: 'donustur',
  },
];
---

<section class="pratik" aria-labelledby="pratik-baslik">
  <h2 id="pratik-baslik" class="section-title">Pratik araçlar</h2>
  <ul class="pratik__liste">
    {
      kutular.map((k) => (
        <li>
          <a class="pratik__kutu" href={k.href} style={`--tint:${k.renk}`}>
            <span class="pratik__simge" aria-hidden="true">
              {k.simge === 'qr' && (
                <svg viewBox="0 0 48 48" fill="none">
                  <rect x="6" y="6" width="14" height="14" rx="3" stroke="currentColor" stroke-width="3" />
                  <rect x="28" y="6" width="14" height="14" rx="3" stroke="currentColor" stroke-width="3" />
                  <rect x="6" y="28" width="14" height="14" rx="3" stroke="currentColor" stroke-width="3" />
                  <rect x="11" y="11" width="4" height="4" fill="currentColor" />
                  <rect x="33" y="11" width="4" height="4" fill="currentColor" />
                  <rect x="11" y="33" width="4" height="4" fill="currentColor" />
                  <path d="M28 28h5v5h-5zM37 37h5v5h-5zM37 28h5M28 37v5" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
                </svg>
              )}
              {k.simge === 'duzenle' && (
                <svg viewBox="0 0 48 48" fill="none">
                  <path d="M12 4h17l9 9v23" stroke="currentColor" stroke-width="3" stroke-linejoin="round" />
                  <path d="M29 4v9h9" stroke="currentColor" stroke-width="3" stroke-linejoin="round" />
                  <path d="M12 4v40h14" stroke="currentColor" stroke-width="3" stroke-linejoin="round" />
                  <path d="m30 44 2-7 9-9 5 5-9 9z" fill="currentColor" />
                  <path d="M18 20h12M18 27h8" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
                </svg>
              )}
              {k.simge === 'donustur' && (
                <svg viewBox="0 0 48 48" fill="none">
                  <rect x="4" y="8" width="18" height="24" rx="3" stroke="currentColor" stroke-width="3" />
                  <rect x="26" y="16" width="18" height="24" rx="3" stroke="currentColor" stroke-width="3" />
                  <path d="m9 26 4-5 3 3 2-2 2 4" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" />
                  <path d="M31 25h8M31 31h6" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
                  <path d="M24 4c6 0 9 3 10 8m0 0 2.5-3M34 12l-3.5-1.5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
                </svg>
              )}
            </span>
            <span class="pratik__ad">{k.ad}</span>
            <span class="pratik__etiketler">
              {k.etiketler.map((e) => (
                <span>{e}</span>
              ))}
            </span>
            <span class="btn-mini btn-mini--primary pratik__ac">Aç</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
